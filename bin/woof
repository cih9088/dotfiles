import sys
import tarfile
import tempfile
import urllib.parse
import urllib.request
import zipfile
from itertools import chain, count

max_downloads = 1
chunk_size = 1024 * 1024  # 1MB
cpid = -1
compressed = "gz"
upload = False
version = 0.5


upload_html = b"""\
<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Woof Upload</title>
    <style>
      #fileInput, #fileInput::file-selector-button, #directoryBtn, #directorySelection {
        font: 13px system-ui, sans-serif;
      }
      #progressWrap { display: none; margin-top: 12px; }
      #progressText { font-family: system-ui, sans-serif; font-size: 14px; }
    </style>
  </head>

  <body>
    <h1>Woof Upload</h1>
    <form id="uploadForm" method="POST" action="/upload" enctype="multipart/form-data">
      <p><label for="fileInput">Files</label> <input id="fileInput" type="file" name="upfile" multiple /></p>
      <p>
        <label for="directoryBtn">Directories</label>
        <button id="directoryBtn" type="button">Choose directory</button>
        <input id="directoryInput" type="file" name="upfile" multiple webkitdirectory hidden />
        <span id="directorySelection">No directory chosen</span>
      </p>
      <p><input id="submitBtn" type="submit" value="Upload!" disabled /></p>
    </form>
    <div id="progressWrap" style="display:none; margin-top:12px;">
      <progress id="progressBar" value="0" max="100"></progress>
      <div id="progressText">0%</div>
    </div>
    <script>
      const form = document.getElementById("uploadForm");
      const fileInput = document.getElementById("fileInput");
      const directoryInput = document.getElementById("directoryInput");
      const directoryBtn = document.getElementById("directoryBtn");
      const directorySelection = document.getElementById("directorySelection");
      const btn = document.getElementById("submitBtn");

      const progressWrap = document.getElementById("progressWrap");
      const progressBar = document.getElementById("progressBar");
      const progressText = document.getElementById("progressText");
      let uploading = false;
      let exhausted = false;

      function syncButtonState() {
        fileInput.disabled = uploading || exhausted;
        directoryInput.disabled = uploading || exhausted;
        directoryBtn.disabled = uploading || exhausted;
        const count = directoryInput.files.length;
        directorySelection.textContent = count
          ? `${count} file${count === 1 ? "" : "s"} selected`
          : "No directory chosen";
        btn.disabled =
          uploading || exhausted ||
          (fileInput.files.length === 0 && directoryInput.files.length === 0);
      }
      fileInput.addEventListener("change", syncButtonState);
      directoryInput.addEventListener("change", syncButtonState);
      directoryBtn.addEventListener("click", () => directoryInput.click());

      function formatBytes(bytes) {
        if (!Number.isFinite(bytes)) return "-";

        const units = ["B", "KB", "MB", "GB", "TB"];
        let i = 0;
        let n = bytes;

        while (n >= 1024 && i < units.length - 1) {
          n /= 1024;
          i++;
        }

        return `${n.toFixed(i === 0 ? 0 : 1)} ${units[i]}`;
      }

      function formatDuration(seconds) {
        if (!Number.isFinite(seconds) || seconds < 0) return "-";

        const s = Math.round(seconds);
        const m = Math.floor(s / 60);
        const r = s % 60;

        return m > 0 ? `${m}m ${r}s` : `${r}s`;
      }

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (uploading || exhausted ||
            (fileInput.files.length === 0 && directoryInput.files.length === 0)) return;

        const fd = new FormData();

        // Normal files
        for (const file of fileInput.files) {
          fd.append("upfile", file, file.name);
        }

        // Directory files: preserve relative paths
        for (const file of directoryInput.files) {
          fd.append(
            "upfile",
            file,
            file.webkitRelativePath || file.name
          );
        }

        const xhr = new XMLHttpRequest();
        xhr.open("POST", form.action, true);

        progressWrap.style.display = "block";
        progressBar.value = 0;
        progressText.textContent = "0%";
        uploading = true;
        syncButtonState();

        const samples = [];
        const windowMs = 3000;
        let lastUiUpdate = 0;

        xhr.upload.onprogress = (event) => {
          if (!event.lengthComputable) return;

          const now = performance.now();
          const loaded = event.loaded;
          const total = event.total;

          samples.push({ t: now, b: loaded });

          while (
            samples.length > 2 &&
            samples[0].t < now - windowMs
          ) {
            samples.shift();
          }

          let recentBps = 0;

          if (samples.length >= 2) {
            const first = samples[0];
            const dt = (now - first.t) / 1000;
            const db = loaded - first.b;

            recentBps = dt > 0 ? db / dt : 0;
          }

          const remainingBytes = total - loaded;
          const etaSec =
            recentBps > 0 ? remainingBytes / recentBps : Infinity;

          const percent = Math.round((loaded / total) * 100);

          if (now - lastUiUpdate >= 250 || loaded === total) {
            progressBar.value = percent;
            progressText.textContent =
              `${percent}% - ${formatBytes(loaded)} / ${formatBytes(total)} ` +
              `(${formatBytes(recentBps)}/s, ETA ${formatDuration(etaSec)})`;

            lastUiUpdate = now;
          }
        };

        xhr.onload = () => {
          if (xhr.status >= 200 && xhr.status < 300) {
            progressBar.value = 100;

            const n = xhr.getResponseHeader("X-Woof-Downloads");

            fileInput.value = "";
            directoryInput.value = "";

            if (n === "0") {
              exhausted = true;

              progressText.textContent =
                "Upload complete and no more uploads are allowed";
            } else {
              progressText.textContent = "Upload complete";
            }
          } else {
            progressText.textContent = `Upload failed (${xhr.status})`;
          }
        };

        xhr.onerror = () => {
          progressText.textContent = "Upload failed (network error)";
        };
        xhr.onabort = () => {
          progressText.textContent = "Upload cancelled";
        };
        xhr.ontimeout = () => {
          progressText.textContent = "Upload failed (timeout)";
        };
        xhr.onloadend = () => {
          uploading = false;
          syncButtonState();
        };

        try {
          xhr.send(fd);
        } catch (error) {
          uploading = false;
          progressText.textContent = "Upload failed (could not send request)";
          syncButtonState();
        }
      });

      syncButtonState();
    </script>
  </body>
</html>
"""


# Utility function to guess the IP (as a string) where the server can be
# reached from the outside. Quite nasty problem actually.


def find_ip():
    # we get a UDP-socket for the TEST-networks reserved by IANA.
    # It is highly unlikely, that there is special routing used
    # for these networks, hence the socket later should give us
    # the ip address of the default route.
    # We're doing multiple tests, to guard against the computer being
    # part of a test installation.

    candidates = []
    for test_ip in ["192.0.2.0", "198.51.100.0", "203.0.113.0"]:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect((test_ip, 80))
        ip_addr = s.getsockname()[0]
        s.close()
        if ip_addr in candidates:
            return ip_addr
        candidates.append(ip_addr)

    return candidates[0]


def decode_multipart_form_data(multipart_data, headers):
    """Decode multipart form data"""
    content_type = headers["Content-Type"]
    content_len = int(headers["Content-Length"])

    boundary = b"--" + re.findall("boundary=(.*);?", content_type)[0].encode()

    n_read = 0
    meta = None
    buffer = bytearray()
    meta = {}
    while n_read < content_len:
        to_read = min(chunk_size, content_len - n_read)
        chunk = multipart_data.read(to_read)
        if not chunk:
            raise EOFError("Unexpected end of upload")
        n_read += len(chunk)
        buffer.extend(chunk)

        while buffer and buffer.startswith(boundary + b"\r\n"):
            del buffer[: len(boundary + b"\r\n")]
            for cand in buffer.split(b"\r\n"):
                if cand.startswith(b"Content-Disposition:"):
                    del buffer[: len(cand) + 2]
                    cand = cand.replace(b"Content-Disposition:", b"")
                    for data in cand.split(b";"):
                        slice = data.decode().strip().split("=", 1)
                        if len(slice) != 2:
                            continue
                        meta[slice[0]] = slice[1][1:-1]
                elif not cand:
                    del buffer[:2]

                    def _iter():
                        nonlocal n_read
                        marker = b"\r\n" + boundary
                        while True:
                            pos = buffer.find(marker)
                            if pos >= 0:
                                end = pos + len(marker)
                                suffix = buffer[end : end + 4]
                                if (
                                    suffix.startswith(b"\r\n")
                                    or suffix == b"--\r\n"
                                    or (suffix == b"--" and n_read == content_len)
                                ):
                                    yield bytes(buffer[:pos])
                                    del buffer[: pos + 2]
                                    break
                                needed = 4 if suffix.startswith(b"--") else 2
                                if len(suffix) >= needed or n_read == content_len:
                                    # False match: keep it as file data and search again.
                                    yield bytes(buffer[: pos + 2])
                                    del buffer[: pos + 2]
                                    continue
                                # Retain the candidate until its ending has arrived.
                                safe = pos
                            else:
                                # Keep any suffix that could begin a split boundary.
                                safe = max(0, len(buffer) - len(marker) + 1)
                            if safe:
                                yield bytes(buffer[:safe])
                                del buffer[:safe]
                            to_read = min(chunk_size, content_len - n_read)
                            if to_read <= 0:
                                raise EOFError("Missing multipart boundary")
                            chunk = multipart_data.read(to_read)
                            if not chunk:
                                raise EOFError("Unexpected end of upload")
                            n_read += len(chunk)
                            buffer.extend(chunk)

                    yield meta, _iter()
                    break
                else:
                    del buffer[: len(cand) + 2]


# our own HTTP server class, fixing up a change in python 2.7
# since we do our fork() in the request handler
# the server must not shutdown() the socket.


class ForkingHTTPServer(http.server.HTTPServer):
    def process_request(self, request, client_address):
        self.finish_request(request, client_address)
        self.close_request(request)


# Main class implementing an HTTP-Requesthandler, that serves just a single
# file and redirects all other requests to this file (this passes the actual
# filename to the client).
# Currently it is impossible to serve different files with different
# instances of this class.


class FileServHTTPRequestHandler(http.server.BaseHTTPRequestHandler):
    server_version = "Simons FileServer"
    protocol_version = "HTTP/1.0"

    filename = "."

    def log_request(self, code="-", size="-"):
        if code == 200:
            super().log_request(code, size)

    def do_POST(self):
        global max_downloads, upload

        if not upload:
            self.send_error(501, "Unsupported method (POST)")
            return

        upload_root = os.path.realpath(".")
        have_upload = False
        try:
            for meta, iterator in decode_multipart_form_data(self.rfile, self.headers):
                if meta is None or meta.get("name", "") != "upfile":
                    continue
                have_upload = True
                upfilename = meta.get("filename", "").replace("\\", "/")
                if (
                    not upfilename
                    or "\x00" in upfilename
                    or os.path.isabs(upfilename)
                    or ntpath.splitdrive(upfilename)[0]
                    or ".." in upfilename.split("/")
                ):
                    self.send_error(403, "Invalid upload path")
                    return

                destination = os.path.join(upload_root, upfilename)
                if os.path.commonpath([upload_root, os.path.realpath(destination)]) != upload_root:
                    self.send_error(403, "Upload path is outside the upload directory")
                    return

                destdir = os.path.dirname(destination)
                os.makedirs(destdir, exist_ok=True)
                tempfd, tempname = tempfile.mkstemp(prefix=".woof-", dir=destdir)
                try:
                    with os.fdopen(tempfd, "wb") as f:
                        for chunk in iterator:
                            f.write(chunk)

                    for suffix in chain.from_iterable([[""], map(lambda x: f".{x}", count(1))]):
                        destfilename = destination + suffix
                        try:
                            os.link(tempname, destfilename)
                        except FileExistsError:
                            continue
                        break
                finally:
                    os.unlink(tempname)

                print(
                    "accepting uploaded file: %s -> %s" % (upfilename, destfilename),
                    file=sys.stderr,
                )
        except EOFError as error:
            self.send_error(400, str(error))
            return
        except OSError as error:
            self.log_error("Upload failed: %s", error)
            self.send_error(500, "Unable to save upload")
            return

        if not have_upload:
            self.send_error(403, "No upload provided?")
            return

        max_downloads -= 1
        self.send_response(200)
        self.send_header("X-Woof-Downloads", str(max_downloads))
        self.end_headers()

        return

    def do_GET(self):
        return self.get_or_head()

    def do_HEAD(self):
        return self.get_or_head(True)

    def get_or_head(self, headers_only=False):
        global max_downloads, cpid, compressed, upload

        # Form for uploading a file
        if upload:
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.send_header("Content-Length", str(len(upload_html)))
            self.end_headers()

            if headers_only:
                return

            self.wfile.write(upload_html)
            return

        # Redirect any request to the filename of the file to serve.
        # This hands over the filename to the client.

        self.path = urllib.parse.quote(urllib.parse.unquote(self.path))
        location = "/" + urllib.parse.quote(os.path.basename(self.filename))
        if os.path.isdir(self.filename):
            if compressed == "gz":
                location += ".tar.gz"
            elif compressed == "bz2":
                location += ".tar.bz2"
            elif compressed == "zip":
                location += ".zip"
            else:
                location += ".tar"

        if self.path != location:
            txt = (
                """\
                <html>
                   <head><title>302 Found</title></head>
                   <body>302 Found <a href="%s">here</a>.</body>
                </html>\n"""
                % location
            )
            txt = txt.encode("ascii")
            self.send_response(302)
            self.send_header("Location", location)
            self.send_header("Content-Type", "text/html")
            self.send_header("Content-Length", str(len(txt)))
            self.end_headers()

            if headers_only:
                return

            self.wfile.write(txt)
            return

        if not headers_only:
            max_downloads -= 1

        # let a separate process handle the actual download, so that
        # multiple downloads can happen simultaneously.

        cpid = os.fork()

        if cpid == 0:
            # Child process
            child = None
            type = None

            if os.path.isfile(self.filename):
                type = "file"
            elif os.path.isdir(self.filename):
                type = "dir"

            if not type:
                print("can only serve files or directories. Aborting.", file=sys.stderr)
                sys.exit(1)

            self.send_response(200)
            self.send_header("Content-Type", "application/octet-stream")
            self.send_header(
                "Content-Disposition",
                "attachment;filename=%s"
                % urllib.parse.quote(
                    os.path.basename(self.filename + self.archive_ext)
                ),
            )
            if os.path.isfile(self.filename):
                self.send_header("Content-Length", os.path.getsize(self.filename))
            self.end_headers()

            if headers_only:
                return

            try:
                if type == "file":
                    datafile = open(self.filename, "rb")
                    shutil.copyfileobj(datafile, self.wfile)
                    datafile.close()
                elif type == "dir":
                    if compressed == "zip":
                        zfile = zipfile.ZipFile(self.wfile, "w", zipfile.ZIP_DEFLATED)
                        stripoff = os.path.dirname(self.filename) + os.sep

                        for root, dirs, files in os.walk(self.filename):
                            for f in files:
                                filename = os.path.join(root, f)
                                if filename[: len(stripoff)] != stripoff:
                                    raise RuntimeException(
                                        "invalid filename assumptions, please report!"
                                    )
                                zfile.write(filename, filename[len(stripoff) :])
                        zfile.close()
                    else:
                        tfile = tarfile.open(
                            mode=("w|" + compressed), fileobj=self.wfile
                        )
                        tfile.add(
                            self.filename, arcname=os.path.basename(self.filename)
                        )
                        tfile.close()

            except Exception as e:
                print(e)
                print("Connection broke. Aborting", file=sys.stderr)


def serve_files(filename, maxdown=1, ip_addr="", port=8080):
    global max_downloads

    max_downloads = maxdown

    archive_ext = ""
    if filename and os.path.isdir(filename):
        if compressed == "gz":
            archive_ext = ".tar.gz"
        elif compressed == "bz2":
            archive_ext = ".tar.bz2"
        elif compressed == "zip":
            archive_ext = ".zip"
        else:
            archive_ext = ".tar"

    # We have to somehow push the filename of the file to serve to the
    # class handling the requests. This is an evil way to do this...

    FileServHTTPRequestHandler.filename = filename
    FileServHTTPRequestHandler.archive_ext = archive_ext

    try:
        httpd = ForkingHTTPServer((ip_addr, port), FileServHTTPRequestHandler)
    except socket.error:
        print(
            "cannot bind to IP address '%s' port %d" % (ip_addr, port), file=sys.stderr
        )
        sys.exit(1)

    if not ip_addr:
        ip_addr = find_ip()
    if ip_addr:
        if filename:
            location = f"http://{ip_addr}:{httpd.server_port}/" + urllib.parse.quote(
                os.path.basename(filename + archive_ext)
            )
        else:
            location = "http://%s:%s/" % (ip_addr, httpd.server_port)

        print("Now serving on %s" % location)

    while cpid != 0 and max_downloads > 0:
        httpd.handle_request()


def usage(defport, defmaxdown, configs, errmsg=None):
    name = os.path.basename(sys.argv[0])
    print(
        f"""
    Usage: {name} [-i <ip_addr>] [-p <port>] [-c <count>] <file>
           {name} [-i <ip_addr>] [-p <port>] [-c <count>] [-z|-j|-Z|-u] <dir>
           {name} [-i <ip_addr>] [-p <port>] [-c <count>] -s
           {name} [-i <ip_addr>] [-p <port>] [-c <count>] -U

           {name} <url>

    Serves a single file <count> times via http on port <port> on IP
    address <ip_addr>.
    When a directory is specified, an tar archive gets served. By default
    it is gzip compressed. You can specify -z for gzip compression,
    -j for bzip2 compression, -Z for ZIP compression or -u for no compression.
    You can configure your default compression method in the configuration
    file described below.

    When -s is specified instead of a filename, {name} distributes itself.

    When -U is specified, woof provides an upload form, allowing file uploads.

    defaults: count = {defmaxdown}, port = {defport}

    If started with an url as an argument, woof acts as a client,
    downloading the file and saving it in the current directory.

    You can specify different defaults in {len(configs)} locations:
      {(os.linesep + "      ").join(configs)}
    These files can be INI-style config files containing the default
    port and the default count. The latter files takes precedence.
    The compression methods are "off", "gz", "bz2" or "zip".

    Sample file:

        [main]
        port = 8008
        count = 2
        ip = 127.0.0.1
        compressed = gz
   """,
        file=sys.stderr,
    )

    if errmsg:
        print(errmsg, file=sys.stderr)
        print(file=sys.stderr)
    sys.exit(1)


def woof_client(url):
    urlparts = urllib.parse.urlparse(url, "http")
    if urlparts[0] not in ["http", "https"] or urlparts[1] == "":
        return None

    fname = None

    f = urllib.request.urlopen(url)

    f_meta = f.info()
    disp = f_meta["Content-Disposition"]

    if disp:
        disp = disp.split(";")

    if disp and disp[0].lower() == "attachment":
        fname = [x[9:] for x in disp[1:] if x[:9].lower() == "filename="]
        if len(fname):
            fname = fname[0]
        else:
            fname = None

    if fname == None:
        url = f.geturl()
        urlparts = urllib.parse.urlparse(url)
        fname = urlparts[2]

    if not fname:
        fname = "woof-out.bin"

    if fname:
        fname = urllib.parse.unquote(fname)
        fname = os.path.basename(fname)

    readline.set_startup_hook(lambda: readline.insert_text(fname))
    fname = input("Enter target filename: ")
    readline.set_startup_hook(None)

    override = False

    destfile = None
    destfilename = os.path.join(".", fname)
    try:
        destfile = os.open(destfilename, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    except OSError as e:
        if e.errno == errno.EEXIST:
            override = input("File exists. Overwrite (y/n)? ")
            override = override.lower() in ["y", "yes"]
        else:
            raise

    if destfile == None:
        if override == True:
            destfile = os.open(destfilename, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
        else:
            for suffix in [".1", ".2", ".3", ".4", ".5", ".6", ".7", ".8", ".9"]:
                destfilename = os.path.join(".", fname + suffix)
                try:
                    destfile = os.open(
                        destfilename, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644
                    )
                    break
                except OSError as e:
                    if e.errno == errno.EEXIST:
                        continue
                    raise

            if not destfile:
                destfile, destfilename = tempfile.mkstemp(prefix=fname + ".", dir=".")
            print("alternate filename is:", destfilename)

    print("downloading file: %s -> %s" % (fname, destfilename))

    shutil.copyfileobj(f, os.fdopen(destfile, "wb"))

    return 1


def main():
    global cpid, upload, compressed

    maxdown = 1
    port = 8080
    ip_addr = ""

    xdgdir = os.environ.get("XDG_CONFIG_HOME", "~/.config")
    configs = [
        "/etc/woofrc",
        os.path.expanduser("~/.woofrc"),
        os.path.expanduser(xdgdir + "/woofrc"),
    ]

    config = configparser.ConfigParser()
    config.read(configs)

    if config.has_option("main", "port"):
        port = config.getint("main", "port")

    if config.has_option("main", "count"):
        maxdown = config.getint("main", "count")

    if config.has_option("main", "ip"):
        ip_addr = config.get("main", "ip")

    if config.has_option("main", "compressed"):
        formats = {
            "gz": "gz",
            "true": "gz",
            "bz": "bz2",
            "bz2": "bz2",
            "zip": "zip",
            "off": "",
            "false": "",
        }
        compressed = config.get("main", "compressed")
        compressed = formats.get(compressed, "gz")

    defaultport = port
    defaultmaxdown = maxdown

    try:
        options, filenames = getopt.gnu_getopt(sys.argv[1:], "hVUszjZui:c:p:")
    except getopt.GetoptError as desc:
        usage(defaultport, defaultmaxdown, configs, desc)

    for option, val in options:
        if option == "-c":
            try:
                maxdown = int(val)
                if maxdown <= 0:
                    raise ValueError
            except ValueError:
                usage(
                    defaultport,
                    defaultmaxdown,
                    configs,
                    "invalid download count: %r. Please specify an integer >= 0." % val,
                )

        elif option == "-i":
            ip_addr = val

        elif option == "-p":
            try:
                port = int(val)
            except ValueError:
                usage(
                    defaultport,
                    defaultmaxdown,
                    configs,
                    "invalid port number: %r. Please specify an integer" % val,
                )

        elif option == "-s":
            filenames.append(__file__)

        elif option == "-h":
            usage(defaultport, defaultmaxdown, configs)

        elif option == "-V":
            name = os.path.basename(sys.argv[0])
            print(f"{name} {version}")
            sys.exit(0)

        elif option == "-U":
            upload = True

        elif option == "-z":
            compressed = "gz"
        elif option == "-j":
            compressed = "bz2"
        elif option == "-Z":
            compressed = "zip"
        elif option == "-u":
            compressed = ""

        else:
            usage(defaultport, defaultmaxdown, configs, "Unknown option: %r" % option)

    if upload:
        if len(filenames) > 0:
            usage(
                defaultport,
                defaultmaxdown,
                configs,
                "Conflicting usage: simultaneous up- and download not supported.",
            )
        filename = None

    else:
        if len(filenames) == 1:
            if woof_client(filenames[0]) != None:
                sys.exit(0)

            filename = os.path.abspath(filenames[0])
        else:
            usage(
                defaultport,
                defaultmaxdown,
                configs,
                "Can only serve single files/directories.",
            )

        if not os.path.exists(filename):
            usage(
                defaultport,
                defaultmaxdown,
                configs,
                "%s: No such file or directory" % filenames[0],
            )

        if not (os.path.isfile(filename) or os.path.isdir(filename)):
            usage(
                defaultport,
                defaultmaxdown,
                configs,
                "%s: Neither file nor directory" % filenames[0],
            )

    serve_files(filename, maxdown, ip_addr, port)

    # wait for child processes to terminate
    if cpid != 0:
        try:
            while 1:
                os.wait()
        except OSError:
            pass


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
